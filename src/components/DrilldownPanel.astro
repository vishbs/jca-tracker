---
// A single shared results panel that chart bars / flags can populate via JS.
// Each clickable element sets data-filter-* attributes; the panel script
// (in stats.astro) reads them, filters the embedded JCA data, and renders rows here.
---

<div id="drilldown-panel" class="drilldown-panel" hidden>
  <div class="drilldown-header">
    <h3 id="drilldown-title">Filtered JCAs</h3>
    <button type="button" id="drilldown-close" aria-label="Close">✕</button>
  </div>
  <div class="drilldown-table-wrap">
    <table>
      <thead>
        <tr>
          <th>Medicine</th>
          <th>Status</th>
          <th>Assessor</th>
          <th>Co-assessor</th>
          <th>Indication</th>
        </tr>
      </thead>
      <tbody id="drilldown-rows"></tbody>
    </table>
  </div>
</div>

<style>
  .drilldown-panel {
    margin-bottom: 24px;
    background: var(--surface-card);
    border: 1px solid color-mix(in srgb, var(--series-1) 30%, var(--border));
    border-radius: var(--radius);
    overflow: hidden;
  }

  .drilldown-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
  }

  .drilldown-header h3 {
    margin: 0;
    font-size: 14.5px;
  }

  #drilldown-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 14px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    line-height: 1;
  }

  #drilldown-close:hover {
    background: color-mix(in srgb, var(--text-primary) 6%, transparent);
    color: var(--text-primary);
  }

  .drilldown-table-wrap {
    overflow-x: auto;
    max-height: 360px;
    overflow-y: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  th, td {
    text-align: left;
    padding: 9px 14px;
    border-bottom: 1px solid var(--gridline);
    white-space: normal;
  }

  th {
    color: var(--text-muted);
    font-weight: 500;
    position: sticky;
    top: 0;
    background: var(--surface-card);
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  tbody tr:hover {
    background: color-mix(in srgb, var(--text-primary) 3%, transparent);
  }

  td a {
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--text-muted);
    text-underline-offset: 3px;
  }

  td a:hover {
    color: var(--series-1);
    text-decoration-color: currentColor;
  }

  .status-pill {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
  }

  .status-ongoing {
    background: color-mix(in srgb, var(--series-1) 16%, transparent);
    color: var(--series-1);
  }

  .status-completed {
    background: color-mix(in srgb, var(--series-3) 16%, transparent);
    color: var(--series-3);
  }

  .status-discontinued {
    background: color-mix(in srgb, var(--series-2) 16%, transparent);
    color: var(--series-2);
  }
</style>
